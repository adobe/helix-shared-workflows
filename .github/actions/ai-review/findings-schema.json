{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "comments", "issues"],
  "properties": {
    "verdict": { "type": "string", "enum": ["approved", "denied"] },
    "summary": { "type": "string" },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "body"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "body": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "title", "body", "security"],
        "properties": {
          "repo": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "security": { "type": "boolean" }
        }
      }
    }
  }
}
